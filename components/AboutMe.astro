---
const perfil = [
  "Desarrollador Web orientado a resultados y adaptabilidad técnica.",
  "Experimentado en desarrollo CMS, maquetación UI y pruebas de software. En constante evolución autodidacta con foco actual en Node.js y Astro para construir aplicaciones modernas, escalables y de alto rendimiento.",
];

const experiencia = [
  {
    empresa: "Brandcode S.L.",
    puesto: "Desarrollador Web Frontend & CMS",
    periodo: "Marzo 2026 — Agosto 2026",
    duracion: "6 meses",
    tareas: [
      "Creación y adaptación de componentes e interfaces web para WordPress y Drupal a partir de diseños en Figma y Zeplin.",
      "Implementación de cambios menores, nuevas secciones y ajustes a medida en WordPress, Drupal y PrestaShop.",
      "Integración y desarrollo de módulos personalizados y externos para optimizar funcionalidades en sitios CMS.",
      "Control del código fuente y colaboración mediante Git.",
    ],
  },
  {
    empresa: "Logical Rioja S.L.",
    puesto: "Desarrollador .NET & QA Tester",
    periodo: "Marzo 2025 — Junio 2025",
    duracion: "4 meses",
    tareas: [
      "Corrección de errores y resolución de bugs en módulos de ERP desarrollados en C# y Visual Basic .NET.",
      "Diseño y ejecución de pruebas unitarias automatizadas con xUnit.",
      "Integración de flujos de testing y automatización en pipelines de Azure DevOps.",
    ],
  },
];

const formacion = [
  {
    titulo: "Grado Superior en Desarrollo de Aplicaciones Web",
    centro: "IES Comercio",
    periodo: "2025 — 2026",
  },
  {
    titulo: "Grado Superior en Desarrollo de Aplicaciones Multiplataforma",
    centro: "IES Comercio",
    periodo: "2023 — 2025",
  },
];

const habilidades = [
  "Trabajo en equipo",
  "Adaptabilidad y polivalencia",
  "Compromiso y orientación a resultados",
  "Mentalidad de crecimiento",
  "Receptividad al feedback constructivo",
];

const idiomas = [
  { idioma: "Español", nivel: "Nativo" },
  { idioma: "Inglés", nivel: "Intermedio [ B2+ ]" },
];

const contacto = {
  ubicacion: "Logroño, La Rioja",
  email: "rtpfm19@gmail.com",
  linkedin: {
    href: "https://www.linkedin.com/in/rtobiasp",
    label: "linkedin.com/in/rtobiasp",
  },
};
---

<section aria-labelledby="sobre-mi-titulo" class="flex min-w-0 flex-col gap-6">
  <div class="flex flex-col gap-2">
    <p class="text-xs font-medium uppercase tracking-[0.32em] text-primary/60">
      Sobre mí
    </p>
    <h2
      id="sobre-mi-titulo"
      class="font-cormorant-garamond text-3xl leading-none text-primary sm:text-4xl"
    >
      Desarrollo con criterio, claridad y enfoque real.
    </h2>
  </div>

  <article
    class="group relative flex min-w-0 flex-col gap-6 overflow-hidden rounded-[28px] border border-white/12 bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.13),_transparent_20%),rgba(10,10,10,0.72)] p-5 shadow-[0_26px_80px_-35px_rgba(0,0,0,0.95)] backdrop-blur-xl transition-all duration-500 ease-out hover:border-white/20 hover:bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.17),_transparent_20%),rgba(10,10,10,0.78)] sm:p-6 md:p-7"
  >
    <div class="grid gap-6 lg:grid-cols-[1.35fr_0.85fr]">
      <div class="flex flex-col gap-4">
        <p
          class="text-sm font-medium uppercase tracking-[0.24em] text-primary/60"
        >
          Desarrollador web
        </p>

        <div class="flex flex-col gap-3">
          {
            perfil.map((parrafo) => (
              <p class="text-sm leading-relaxed text-primary/75 md:text-[15px]">
                {parrafo}
              </p>
            ))
          }
        </div>
      </div>

      <aside
        class="flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/4 p-4 sm:p-5"
      >
        <div>
          <p
            class="text-[10px] font-semibold uppercase tracking-[0.25em] text-primary/55"
          >
            Enfoque
          </p>
          <p class="mt-3 text-base font-medium text-primary">
            Soluciones funcionales, limpias y pensadas para resultados reales.
          </p>
        </div>

        <ul aria-label="Habilidades clave" class="flex flex-wrap gap-2">
          {
            ["Frontend", "CMS", "UI", "Node.js", "Astro", "QA"].map((item) => (
              <li class="rounded-full border border-white/12 bg-white/5 px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-primary/80">
                {item}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    <span
      aria-hidden="true"
      class="h-px bg-linear-to-r from-transparent via-white/18 to-transparent"
    ></span>

    <div class="grid gap-6 xl:grid-cols-2">
      <section
        class="flex min-w-0 flex-col gap-4 rounded-2xl border border-white/8 bg-black/20 p-4 sm:p-5"
      >
        <div class="flex items-center justify-between gap-3">
          <h3
            class="text-xs font-semibold uppercase tracking-[0.25em] text-primary/70"
          >
            Experiencia laboral
          </h3>
          <span
            class="h-2.5 w-2.5 rounded-full bg-primary/70"
            aria-hidden="true"></span>
        </div>

        <ol class="flex flex-col gap-5">
          {
            experiencia.map((item) => (
              <li class="flex min-w-0 flex-col gap-2 rounded-xl border border-white/8 bg-white/[0.02] p-3.5">
                <div class="flex flex-col gap-1 sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between sm:gap-2">
                  <h4 class="font-cormorant-garamond text-xl leading-tight text-primary sm:text-[1.35rem]">
                    {item.puesto}
                  </h4>
                  <p class="text-[10px] uppercase tracking-[0.2em] text-primary/55">
                    {item.duracion}
                  </p>
                </div>

                <p class="text-sm font-medium text-primary/85">
                  {item.empresa}{" "}
                  <span class="font-normal text-primary/50">
                    · {item.periodo}
                  </span>
                </p>

                <ul class="flex list-disc flex-col gap-1.5 pl-5 text-sm leading-relaxed text-primary/70">
                  {item.tareas.map((tarea) => (
                    <li>{tarea}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="flex min-w-0 flex-col gap-4 rounded-2xl border border-white/8 bg-black/20 p-4 sm:p-5"
      >
        <div class="flex items-center justify-between gap-3">
          <h3
            class="text-xs font-semibold uppercase tracking-[0.25em] text-primary/70"
          >
            Formación
          </h3>
          <span
            class="h-2.5 w-2.5 rounded-full bg-primary/70"
            aria-hidden="true"></span>
        </div>

        <ul class="flex flex-col gap-3">
          {
            formacion.map((item) => (
              <li class="rounded-xl border border-white/8 bg-white/[0.02] p-3.5">
                <p class="text-sm font-medium text-primary/90">{item.titulo}</p>
                <p class="mt-2 text-sm text-primary/60">
                  {item.centro} <span aria-hidden="true">·</span> {item.periodo}
                </p>
              </li>
            ))
          }
        </ul>

        <div class="flex flex-col gap-4 pt-1">
          <h3
            class="text-xs font-semibold uppercase tracking-[0.25em] text-primary/70"
          >
            Idiomas
          </h3>
          <dl class="flex flex-col gap-2">
            {
              idiomas.map((item) => (
                <div class="flex items-baseline justify-between gap-2 rounded-lg border border-white/8 bg-white/[0.02] px-3 py-2 text-sm">
                  <dt class="font-medium text-primary/90">{item.idioma}</dt>
                  <dd class="text-primary/60">{item.nivel}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>
    </div>

    <span
      aria-hidden="true"
      class="h-px bg-linear-to-r from-transparent via-white/18 to-transparent"
    ></span>

    <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr]">
      <section class="flex flex-col gap-4">
        <h3
          class="text-xs font-semibold uppercase tracking-[0.25em] text-primary/70"
        >
          Habilidades
        </h3>
        <ul aria-label="Habilidades" class="flex flex-wrap gap-2">
          {
            habilidades.map((habilidad) => (
              <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-primary/80 transition-colors duration-300 group-hover:border-white/15">
                {habilidad}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="flex flex-col gap-4">
        <h3
          class="text-xs font-semibold uppercase tracking-[0.25em] text-primary/70"
        >
          Contacto
        </h3>
        <address class="flex flex-col gap-2 text-sm not-italic text-primary/70">
          <p>{contacto.ubicacion}</p>
          <a
            href={`mailto:${contacto.email}`}
            class="w-fit rounded text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            {contacto.email}
          </a>
          <a
            href={contacto.linkedin.href}
            target="_blank"
            rel="noopener noreferrer"
            class="w-fit break-all rounded text-primary/80 underline-offset-4 hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            {contacto.linkedin.label}
          </a>
        </address>
      </section>
    </div>

    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-12 bottom-0 h-px bg-linear-to-r from-transparent via-white/40 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    ></span>
  </article>
</section>

<style>
  .font-cormorant-garamond {
    font-family: var(--font-cormorant-garamond);
  }
</style>
