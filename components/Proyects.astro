---
import type { ImageMetadata } from "astro";
import ProjectCard from "./ui/ProjectCard.astro";

const posts = Object.values(
  import.meta.glob("/src/proyectos/*.md", { eager: true }),
);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/proyectos/media/*.{jpeg,jpg,png,gif}",
  { eager: true },
);
---

<section aria-label="Listado de proyectos" class="flex min-w-0 flex-col gap-5 sm:gap-6">
  <nav class="min-w-0">
    <ul class="flex min-w-0 flex-col gap-5 sm:gap-6">
      {
        posts.map((post: any) => (
          <li>
            <ProjectCard
              title={post.frontmatter.title}
              description={post.frontmatter.description}
              technologies={post.frontmatter.technologies ?? []}
              image={images[post.frontmatter.img]?.default}
              imageAlt={`Imagen de ${post.frontmatter.title}`}
              linkWeb={post.frontmatter.link_web}
              linkGithub={post.frontmatter.link_github}
            />
          </li>
        ))
      }
    </ul>
  </nav>
</section>
