---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  technologies?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  linkWeb?: string;
  linkGithub?: string;
  projectNumber?: number;
  class?: string;
}

const {
  title,
  description,
  technologies = [],
  image,
  imageAlt = `Imagen del proyecto ${title}`,
  linkWeb = "",
  linkGithub = "",
  projectNumber = 1,
  class: className = "",
} = Astro.props;

const hasWeb = Boolean(linkWeb?.trim());
const hasGithub = Boolean(linkGithub?.trim());
const visibleTechs = technologies.slice(0, 4);
const remainingTechs = technologies.length - visibleTechs.length;
---

<article
  class:list={[
    "group flex flex-col overflow-hidden border border-white/15 bg-neutral-950/90",
    "transition-colors duration-300 hover:border-white/35",
    className,
  ]}
>
  {
    image && (
      <div class="relative aspect-[16/9] overflow-hidden border-b border-white/10 bg-neutral-900">
        <Image
          src={image}
          alt={imageAlt}
          widths={[400, 800, 1200]}
          sizes="(max-width: 640px) 100vw, 50vw"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col px-5 sm:px-6">
    <div
      class="flex items-center justify-between border-b border-white/10 py-3"
    >
      <p
        class="font-montserrat text-[10px] font-semibold uppercase tracking-[0.18em] text-primary/55"
      >
        Proyecto <span class="text-primary/90"
          >{String(projectNumber).padStart(2, "0")}</span
        >
      </p>
      <span aria-hidden="true" class="h-px w-10 bg-white/45"></span>
    </div>

    <div class="flex flex-1 flex-col gap-4 py-5 sm:py-6">
      <div class="flex flex-col gap-2">
        <h3
          class="font-cormorant-garamond text-3xl leading-[0.95] text-primary sm:text-4xl"
        >
          {title}
        </h3>
        <p
          class="font-montserrat text-[13px] leading-relaxed text-primary/70 sm:text-sm"
        >
          {description}
        </p>
      </div>

      {
        technologies.length > 0 && (
          <div class="mt-auto border-t border-white/10 pt-3">
            <p class="mb-1 font-montserrat text-[9px] font-semibold uppercase tracking-[0.16em] text-primary/40">
              Stack
            </p>
            <p
              aria-label={`Tecnologías usadas en ${title}`}
              class="font-montserrat text-[10px] leading-relaxed text-primary/65 sm:text-[11px]"
            >
              {visibleTechs.join(" / ")}
              {remainingTechs > 0 && ` / +${remainingTechs}`}
            </p>
          </div>
        )
      }

      <div class="flex min-h-12 items-center gap-6 border-t border-white/10">
        {
          hasWeb ? (
            <a
              href={linkWeb}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver proyecto ${title} (se abre en pestaña nueva)`}
              class="group/link inline-flex items-center gap-2 font-montserrat text-[10px] font-semibold uppercase tracking-[0.12em] text-primary transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              Ver sitio
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          ) : (
            <span class="font-montserrat text-[10px] font-medium uppercase tracking-[0.12em] text-primary/35">
              Próximamente
            </span>
          )
        }
        {
          hasGithub && (
            <a
              href={linkGithub}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver código de ${title} en GitHub (se abre en pestaña nueva)`}
              class="inline-flex items-center gap-2 font-montserrat text-[10px] font-semibold uppercase tracking-[0.12em] text-primary/60 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              Código
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .font-cormorant-garamond {
    font-family: var(--font-cormorant-garamond);
  }
  .font-montserrat {
    font-family: var(--font-montserrat);
  }
</style>
