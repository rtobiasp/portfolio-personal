---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  technologies?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  linkWeb?: string;
  linkGithub?: string;
  class?: string;
}

const {
  title,
  description,
  technologies = [],
  image,
  imageAlt = `Imagen del proyecto ${title}`,
  linkWeb = "",
  linkGithub = "",
  class: className = "",
} = Astro.props;

const hasWeb = Boolean(linkWeb?.trim());
const hasGithub = Boolean(linkGithub?.trim());
const visibleTechs = technologies.slice(0, 6);
const remainingTechs = technologies.length - visibleTechs.length;
---

<article
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-3xl",
    "border border-white/10 bg-black/45 backdrop-blur-xl",
    "shadow-[0_20px_60px_-20px_rgba(0,0,0,0.8)]",
    "transition-all duration-500 ease-out",
    "hover:border-white/25 hover:bg-black/55",
    "hover:shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)]",
    className,
  ]}
>
  {
    image && (
      <div class="relative overflow-hidden bg-black/30">
        <Image src={image} alt={imageAlt} class="h-auto w-full object-cover" />
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/80 via-black/10 to-transparent"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6 md:p-7">
    <div class="flex flex-col gap-2">
      <h3
        class="font-cormorant-garamond text-xl leading-tight text-primary sm:text-2xl md:text-3xl"
      >
        {title}
      </h3>
      <p
        class="text-sm leading-relaxed text-primary/70 line-clamp-4 sm:line-clamp-3 md:text-[15px]"
      >
        {description}
      </p>
    </div>

    {
      technologies.length > 0 && (
        <ul
          aria-label={`Tecnologías usadas en ${title}`}
          class="flex flex-wrap gap-2"
        >
          {visibleTechs.map((tech) => (
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-primary/80 transition-colors duration-300 group-hover:border-white/15">
              {tech}
            </li>
          ))}
          {remainingTechs > 0 && (
            <li
              title={technologies.slice(6).join(", ")}
              class="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-semibold text-primary"
            >
              +{remainingTechs}
            </li>
          )}
        </ul>
      )
    }

    <div class="mt-auto flex flex-col flex-wrap gap-3 pt-2 sm:flex-row sm:items-center">
      {
        hasWeb ? (
          <a
            href={linkWeb}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-primary px-5 py-2.5 text-sm font-semibold text-black transition-all duration-300 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:w-auto"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 7h10v10" />
              <path d="M7 17 17 7" />
            </svg>
            Ver proyecto
          </a>
        ) : (
          <span class="inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-medium text-primary/40 sm:w-auto">
            Próximamente
          </span>
        )
      }
      {
        hasGithub && (
          <a
            href={linkGithub}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver código de ${title} en GitHub`}
            class="inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-primary transition-all duration-300 hover:border-white/40 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:w-auto"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            Código
          </a>
        )
      }
    </div>
  </div>

  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-12 bottom-0 h-px bg-linear-to-r from-transparent via-white/40 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
  ></span>
</article>

<style>
  .font-cormorant-garamond {
    font-family: var(--font-cormorant-garamond);
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .sm\:line-clamp-3 {
      -webkit-line-clamp: 3;
    }
  }
</style>
