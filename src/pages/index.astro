---
import "../../src/styles/global.css";
import ContactLinks from "../../components/ui/ContactLinks.astro";
import SectionNav from "../../components/ui/SectionNav.astro";

import video_webm from "../media/background_video.webm";
import video_mp4 from "../media/background_video.mp4";
import Proyects from "../../components/Proyects.astro";
import AboutMe from "../../components/AboutMe.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body class="overflow-x-clip">
    <div aria-hidden="true" class="fixed inset-0 -z-10 overflow-hidden">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        class="video-fondo"
      >
        <source src={video_webm} type="video/webm" />
        <source src={video_mp4} type="video/mp4" />
        Tu navegador no soporta vídeos en HTML5.
      </video>
    </div>
    <main class="mx-auto flex min-h-svh w-full max-w-360 flex-col gap-10 px-5 py-10 sm:px-8 sm:py-12 lg:grid lg:h-screen lg:min-h-0 lg:grid-cols-[55%_45%] lg:gap-6 lg:overflow-hidden lg:p-12 xl:grid-cols-[60%_40%] xl:p-20">
      <section id="info" class="flex min-h-0 flex-col justify-center gap-8 lg:gap-10">
        <div class="flex flex-col gap-5 sm:gap-6">
          <h1 class="font-cormorant-garamond text-[clamp(3.5rem,14vw,6rem)] leading-[0.9] text-primary sm:text-8xl xl:text-9xl">RUBÉN<br />TOBÍAS</h1>
          <p
            class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium uppercase tracking-[0.2em] text-primary/90 sm:text-base sm:tracking-[0.35em] md:text-xl"
          >
            <span aria-hidden="true" class="h-px w-8 bg-primary/60 sm:w-12"></span>
            Desarrollador Full-Stack
          </p>
          <ContactLinks />
        </div>
        <SectionNav />
      </section>
      <section id="panel-derecha" class="min-h-0 h-auto overflow-visible lg:h-full lg:overflow-y-auto lg:pr-1">
        <div id="panel-content">
          <div id="panel-sobre-mi" data-section-panel hidden>
            <AboutMe />
          </div>
          <div id="panel-proyectos" data-section-panel>
            <Proyects />
          </div>
        </div>
      </section>
    </main>

    <script>
      import Lenis from "lenis";

      const wrapper = document.getElementById("panel-derecha");
      const content = document.getElementById("panel-content");
      const desktopQuery = window.matchMedia("(min-width: 1024px)");

      let lenis: Lenis | null = null;

      function initLenis() {
        if (wrapper && content && desktopQuery.matches) {
          if (!lenis) {
            lenis = new Lenis({
              wrapper,
              content,
              autoRaf: true,
              lerp: 0.09,
              smoothWheel: true,
            });
          }
        } else {
          lenis?.destroy();
          lenis = null;
        }
      }

      initLenis();
      // Activa / desactiva el scroll suavizado interno al cambiar de breakpoint
      desktopQuery.addEventListener("change", initLenis);

      // Limpieza si Astro recarga / navega
      document.addEventListener("astro:before-swap", () => lenis?.destroy(), {
        once: true,
      });

      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-section-btn]"),
      );
      const panels = Array.from(
        document.querySelectorAll<HTMLElement>("[data-section-panel]"),
      );

      function showPanel(targetId: string) {
        panels.forEach((panel) => {
          const isActive = panel.id === targetId;
          panel.hidden = !isActive;
          if (isActive) {
            panel.classList.remove("section-enter");
            // Reinicia la animación de entrada
            void panel.offsetWidth;
            panel.classList.add("section-enter");
          }
        });

        buttons.forEach((button) => {
          const isActive = button.dataset.sectionBtn === targetId;
          button.dataset.active = isActive ? "true" : "false";
          if (isActive) {
            button.setAttribute("aria-current", "true");
          } else {
            button.removeAttribute("aria-current");
          }
        });

        if (lenis) {
          lenis.scrollTo(0, { immediate: true });
        } else {
          wrapper?.scrollTo({ top: 0 });
        }
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const target = button.dataset.sectionBtn;
          if (target) showPanel(target);
        });
      });
    </script>

    <style>
      .font-cormorant-garamond {
        font-family: var(--font-cormorant-garamond);
      }

      .section-enter {
        animation: section-enter 0.45s ease-out both;
      }

      @keyframes section-enter {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .section-enter {
          animation: none;
        }
      }
    </style>
  </body>
</html>
