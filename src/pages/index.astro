---
import "../../src/styles/global.css";
import ContactLinks from "../../components/ui/ContactLinks.astro";
import SectionNav from "../../components/ui/SectionNav.astro";

import video_webm from "../media/background_video.webm";
import video_mp4 from "../media/background_video.mp4";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body class="overflow-hidden">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      class="video-fondo"
    >
      <source src={video_webm} type="video/webm" />
      <source src={video_mp4} type="video/mp4" />
      Tu navegador no soporta vídeos en HTML5.
    </video>
    <main class="grid grid-cols-[60%_40%] h-screen p-20">
      <section id="info" class="flex flex-col gap-10">
        <div class="flex flex-col gap-6">
          <h1 class="text-9xl font-fold text-primary">RUBÉN<br />TOBÍAS</h1>
          <p
            class="flex items-center gap-4 text-lg font-medium uppercase tracking-[0.35em] text-primary/90 md:text-xl"
          >
            <span aria-hidden="true" class="h-px w-12 bg-primary/60"></span>
            Desarrollador Full-Stack
          </p>
          <ContactLinks />
        </div>
        <SectionNav />
      </section>
      <section id="proyects" class="bg-amber-200/20"></section>
    </main>
  </body>
</html>
