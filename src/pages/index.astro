---
import "../../src/styles/global.css";
import ContactLinks from "../../components/ui/ContactLinks.astro";
import SectionNav from "../../components/ui/SectionNav.astro";

import video_webm from "../media/background_video.webm";
import video_mp4 from "../media/background_video.mp4";
import Proyects from "../../components/Proyects.astro";
import AboutMe from "../../components/AboutMe.astro";

const SITE_URL = "https://ruben-tobias-dev.vercel.app";
const pageTitle = "Rubén Tobías | Desarrollador Full-Stack en Logroño";
const pageDescription =
  "Portfolio de Rubén Tobías, desarrollador Full-Stack en Logroño (La Rioja): proyectos con Astro, Next.js, React, Node.js y .NET, experiencia laboral, formación y contacto.";
const canonicalUrl = `${SITE_URL}/`;
const ogImageUrl = `${SITE_URL}/og-cover.png`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Rubén Tobías" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rubén Tobías — Desarrollador Full-Stack" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Portfolio de Rubén Tobías, desarrollador Full-Stack" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Rubén Tobías",
        jobTitle: "Desarrollador Full-Stack",
        description: pageDescription,
        url: canonicalUrl,
        address: {
          "@type": "PostalAddress",
          addressLocality: "Logroño",
          addressRegion: "La Rioja",
          addressCountry: "ES",
        },
        email: "mailto:rtpfm19@gmail.com",
        sameAs: [
          "https://www.linkedin.com/in/ruben-tobias-pascual-38a30a431/",
          "https://github.com/rtobiasp",
        ],
        knowsAbout: ["Astro", "Next.js", "React", "Node.js", "TypeScript", ".NET", "WordPress", "Drupal"],
      })}
    />
  </head>
  <body class="overflow-x-clip">
    <a href="#contenido" class="skip-link">Saltar al contenido principal</a>
    <div aria-hidden="true" class="fixed inset-0 -z-10 overflow-hidden">
      <video
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        class="video-fondo"
      >
        <source src={video_webm} type="video/webm" />
        <source src={video_mp4} type="video/mp4" />
        Tu navegador no soporta vídeos en HTML5.
      </video>
    </div>
    <main id="contenido" class="mx-auto flex min-h-svh w-full max-w-360 flex-col gap-10 px-5 py-10 sm:px-8 sm:py-12 lg:grid lg:h-screen lg:min-h-0 lg:grid-cols-[55%_45%] lg:gap-6 lg:overflow-hidden lg:p-12 xl:grid-cols-[60%_40%] xl:p-20">
      <header class="flex min-h-0 flex-col justify-center gap-8 lg:gap-10">
        <div class="flex flex-col gap-5 sm:gap-6">
          <h1 class="font-cormorant-garamond text-[clamp(3.5rem,14vw,6rem)] leading-[0.9] text-primary sm:text-8xl xl:text-9xl">RUBÉN<br />TOBÍAS</h1>
          <p
            class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium uppercase tracking-[0.2em] text-primary/90 sm:text-base sm:tracking-[0.35em] md:text-xl"
          >
            <span aria-hidden="true" class="h-px w-8 bg-primary/60 sm:w-12"></span>
            Desarrollador Full-Stack
          </p>
          <ContactLinks />
        </div>
        <SectionNav />
        <p class="text-xs text-primary/60">
          © 2026 Rubén Tobías · Logroño, La Rioja
        </p>
      </header>
      <section id="panel-derecha" aria-label="Contenido de las secciones" class="min-h-0 h-auto overflow-visible lg:h-full lg:overflow-y-auto lg:pr-1">
        <div id="panel-content">
          <div id="panel-sobre-mi" role="tabpanel" aria-labelledby="tab-panel-sobre-mi" tabindex="0" data-section-panel hidden>
            <AboutMe />
          </div>
          <div id="panel-proyectos" role="tabpanel" aria-labelledby="tab-panel-proyectos" tabindex="0" data-section-panel>
            <Proyects />
          </div>
        </div>
      </section>
    </main>

    <script>
      import Lenis from "lenis";

      const wrapper = document.getElementById("panel-derecha");
      const content = document.getElementById("panel-content");
      const desktopQuery = window.matchMedia("(min-width: 1024px)");
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const bgVideo = document.querySelector<HTMLVideoElement>(".video-fondo");

      function applyReducedMotion() {
        if (reducedMotionQuery.matches) {
          lenis?.destroy();
          lenis = null;
          bgVideo?.pause();
          bgVideo?.removeAttribute("autoplay");
        }
      }

      let lenis: Lenis | null = null;

      function initLenis() {
        if (reducedMotionQuery.matches) {
          lenis?.destroy();
          lenis = null;
          return;
        }
        if (wrapper && content && desktopQuery.matches) {
          if (!lenis) {
            lenis = new Lenis({
              wrapper,
              content,
              autoRaf: true,
              lerp: 0.09,
              smoothWheel: true,
            });
          }
        } else {
          lenis?.destroy();
          lenis = null;
        }
      }

      initLenis();
      applyReducedMotion();
      desktopQuery.addEventListener("change", initLenis);
      reducedMotionQuery.addEventListener("change", () => {
        initLenis();
        applyReducedMotion();
      });

      document.addEventListener("astro:before-swap", () => lenis?.destroy(), {
        once: true,
      });

      const tabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-section-btn]"),
      );
      const panels = Array.from(
        document.querySelectorAll<HTMLElement>("[data-section-panel]"),
      );

      function showPanel(targetId: string, focusTab = false) {
        panels.forEach((panel) => {
          panel.hidden = panel.id !== targetId;
        });

        tabs.forEach((tab) => {
          const isActive = tab.dataset.sectionBtn === targetId;
          tab.dataset.active = isActive ? "true" : "false";
          tab.setAttribute("aria-selected", isActive ? "true" : "false");
          tab.tabIndex = isActive ? 0 : -1;
          if (focusTab && isActive) tab.focus();
        });

        const activePanel = document.getElementById(targetId);
        if (activePanel && !reducedMotionQuery.matches) {
          activePanel.classList.remove("section-enter");
          void activePanel.offsetWidth;
          activePanel.classList.add("section-enter");
        }

        if (lenis) {
          lenis.scrollTo(0, { immediate: true });
        } else {
          wrapper?.scrollTo({ top: 0 });
        }
      }

      function focusTab(index: number) {
        const tab = tabs[(index + tabs.length) % tabs.length];
        showPanel(tab.dataset.sectionBtn ?? "", true);
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          const target = tab.dataset.sectionBtn;
          if (target) showPanel(target);
        });
        tab.addEventListener("keydown", (event) => {
          if (event.key === "ArrowRight") {
            event.preventDefault();
            focusTab(index + 1);
          } else if (event.key === "ArrowLeft") {
            event.preventDefault();
            focusTab(index - 1);
          } else if (event.key === "Home") {
            event.preventDefault();
            focusTab(0);
          } else if (event.key === "End") {
            event.preventDefault();
            focusTab(tabs.length - 1);
          }
        });
      });
    </script>

    <style>
      .font-cormorant-garamond {
        font-family: var(--font-cormorant-garamond);
      }

      .section-enter {
        animation: section-enter 0.45s ease-out both;
      }

      @keyframes section-enter {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .section-enter {
          animation: none;
        }
      }
    </style>
  </body>
</html>
