---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

import video_webm from "../media/background_video.webm";
import video_mp4 from "../media/background_video.mp4";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Rubén Tobías</title>
    <meta
      name="description"
      content="La página que buscas no existe en el portfolio de Rubén Tobías."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="not-found-body">
    <div aria-hidden="true" class="video-backdrop">
      <video
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        class="video-fondo"
      >
        <source src={video_webm} type="video/webm" />
        <source src={video_mp4} type="video/mp4" />
        Tu navegador no soporta vídeos en HTML5.
      </video>
    </div>

    <main class="not-found-page">
      <div class="not-found-content">
        <p class="eyebrow">Error 404</p>
        <h1>404</h1>
        <p class="subtitle">La página que buscas no existe.</p>
        <p class="description">
          El enlace puede estar roto, la dirección ya no está disponible o
          simplemente no existe en este portfolio.
        </p>

        <div class="actions">
          <a href="/" class="primary-link">Volver al inicio</a>
          <a href="/#panel-proyectos" class="secondary-link">Ver proyectos</a>
        </div>
      </div>
    </main>
    <Analytics />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .not-found-body {
    min-height: 100vh;
    position: relative;
    background: #000;
    color: #fff;
    overflow-x: clip;
  }

  .video-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .video-fondo {
    position: absolute;
    inset: -20px;
    width: calc(100% + 40px);
    height: calc(100% + 40px);
    object-fit: cover;
    filter: blur(8px) brightness(0.35);
    transform: scale(1.05);
    pointer-events: none;
  }

  .not-found-page {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: 2rem;
  }

  .not-found-content {
    width: min(100%, 46rem);
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.5rem;
    background: rgba(11, 11, 11, 0.7);
    backdrop-filter: blur(14px);
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.45);
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-size: clamp(5rem, 16vw, 12rem);
    line-height: 0.82;
    letter-spacing: -0.08em;
    color: #fff;
    font-family: var(--font-cormorant-garamond);
  }

  .subtitle {
    margin: 0.75rem 0 0;
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    line-height: 1;
    font-family: var(--font-cormorant-garamond);
    color: #fff;
  }

  .description {
    max-width: 35rem;
    margin: 1.25rem auto 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.75;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .primary-link,
  .secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.125rem;
    padding: 0.875rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .primary-link {
    background: #fff;
    color: #111;
  }

  .secondary-link {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.02);
    color: #fff;
  }

  .primary-link:hover,
  .secondary-link:hover,
  .primary-link:focus-visible,
  .secondary-link:focus-visible {
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .actions {
      flex-direction: column;
    }

    .primary-link,
    .secondary-link {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-fondo {
      display: none;
    }
  }
</style>
